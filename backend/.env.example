# backend/.env.example -> copy to backend/.env (never commit backend/.env).
#
# Every value below is optional. With none set the backend still starts in
# offline mode (LLM_CHAIN=rules, GNANI_MOCK=1) and serves /api/health and
# /api/parse. Only /api/me and /api/recipes require Supabase.
#
# The names here match backend/app/config.py exactly. Real environment
# variables (e.g. those set by a hosting platform) override this file.
#
# PowerShell:  Copy-Item backend\.env.example backend\.env

# --- Supabase: Auth + PostgreSQL (needed for /api/me and /api/recipes) ---
# Project URL and the *publishable* key. The publishable key is public project
# metadata, not a password and not a JWT signing key. Data requests carry each
# signed-in user's access token, so no database password, connection string or
# service-role key belongs here (a service-role key must never reach a browser).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; prefer SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_ANON_KEY=
# Expected token audience and auth/JWKS request tuning.
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=300
SUPABASE_REQUEST_TIMEOUT=10.0

# --- CORS: browser origins allowed to call this API (comma-separated) ---
# Local Vite dev server. Add your deployed frontend origin here for production.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM parser chain (optional) ---
# "rules" is the deterministic offline floor and must remain last.
# mode="auto" walks this chain; mode="llm" requests Gemini explicitly (M-10).
# e.g. LLM_CHAIN=gemini,rules selects Gemini first.
LLM_CHAIN=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Gnani speech services (optional; not exercised by the current frontend) ---
# Leave the key empty, or keep GNANI_MOCK=1, to stay fully offline.
# GNANI_API_KEY=
# GNANI_MOCK=1
