# Copy to .env and fill in only what you need. Never commit .env.
# With no keys at all the app still runs in mock mode.

# --- Gnani speech services (Prisma STT, Timbre TTS) ---
# Leave the key empty, or set GNANI_MOCK=1, to stay fully offline.
GNANI_API_KEY=
GNANI_MOCK=1
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_VOICE=Shivani

# --- LLM provider chain (comma order; "rules" is the offline floor) ---
# mode="rules" always uses the offline parser; mode="auto" walks this chain and
# uses the first implemented provider; mode="llm" uses Gemini (M-10).
# e.g. LLM_CHAIN=gemini,rules selects Gemini first.
LLM_CHAIN=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
LLM_REPLAY_ONLY=0

# --- Supabase: authentication (frontend) + PostgreSQL (backend) ---
# Frontend (React/Vite, publishable values only): the project URL and the anon
# key. In the Vite app these are read as VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY (frontend/.env.example lands with task S-15).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only: PostgreSQL connection string used by FastAPI. Never exposed to
# the browser. A service-role key is deliberately not listed here: the
# repository enforces ownership itself, and a privileged key would bypass RLS.
SUPABASE_DB_URL=
