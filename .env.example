# Copy to .env and fill in only what you need. Never commit .env.
# With no keys at all the app still runs in mock mode.

# --- Gnani speech services (Prisma STT, Timbre TTS) ---
# Leave the key empty, or set GNANI_MOCK=1, to stay fully offline.
GNANI_API_KEY=
GNANI_MOCK=1
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_VOICE=Shivani

# --- LLM provider chain (comma order; "rules" is the offline floor) ---
# mode="rules" always uses the offline parser; mode="auto" walks this chain and
# uses the first implemented provider; mode="llm" uses Gemini (M-10).
# e.g. LLM_CHAIN=gemini,rules selects Gemini first.
LLM_CHAIN=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
LLM_REPLAY_ONLY=0

# --- Supabase: Auth + PostgreSQL Data API ---
# Backend: project URL and the publishable key. The publishable key is public
# project metadata, never a password, and is not a JWT signing key.
# Data requests carry the signed-in user's access token; no database password,
# connection string or service-role key is needed (and a service-role key must
# never be exposed to the browser).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; prefer SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_ANON_KEY=
# Optional: JWT audience (default) and the browser origin allowed by CORS.
SUPABASE_JWT_AUDIENCE=authenticated
FRONTEND_ORIGINS=http://localhost:5173
