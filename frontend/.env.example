# frontend/.env.example -> copy to frontend/.env (never commit frontend/.env).
# Vite loads frontend/.env automatically; every name must start with VITE_.
#
# PowerShell:  Copy-Item frontend\.env.example frontend\.env
#
# These values are embedded at build time. Changing them requires a new
# `npm run build`; a production host must receive them before building.
# Never put a backend secret or a Supabase service-role key in a VITE_ variable.

# Supabase project URL and *publishable* key (public project metadata, used
# only for sign-in/sign-out and session handling). Leave empty for local UI
# work that does not need accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the FastAPI backend. Local default; set the deployed HTTPS URL
# for production builds. The frontend appends /api/... itself.
VITE_API_BASE_URL=http://127.0.0.1:8000
